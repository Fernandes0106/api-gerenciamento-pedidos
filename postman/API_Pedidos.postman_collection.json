{
  "info": {
    "name": "API de Gerenciamento de Pedidos",
    "description": "Requisições usadas nas evidências da pasta evidencias/. Rode a API com npm start antes de enviar. Envie na ordem: a 01 cria o pedido de id 1 usado na 05.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "01 - Criação (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Carlos Silva\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}"
        },
        "url": "{{baseUrl}}/pedidos"
      }
    },
    {
      "name": "02 - Validação (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"   \",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}"
        },
        "url": "{{baseUrl}}/pedidos"
      }
    },
    {
      "name": "03 - Listagem (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/pedidos"
      }
    },
    {
      "name": "04 - Consulta inexistente (404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/pedidos/9999"
      }
    },
    {
      "name": "05 - Atualização de status (200)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"em_preparacao\"\n}"
        },
        "url": "{{baseUrl}}/pedidos/1/status"
      }
    }
  ]
}
